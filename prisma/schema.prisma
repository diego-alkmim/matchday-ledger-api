generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DIRETOR
}

enum TransactionType {
  ENTRADA
  SAIDA
}

enum PaymentMethod {
  PIX
  DINHEIRO
  CARTAO
}

enum GameStatus {
  ABERTO
  FECHADO
}

enum CategoryType {
  ENTRADA
  SAIDA
}

enum ContributionMode {
  PER_GAME
  MONTHLY
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  passwordHash String
  memberships  TeamMembership[]
  createdAt    DateTime         @default(now())
}

model Team {
  id                             String           @id @default(cuid())
  name                           String
  slug                           String           @unique
  active                         Boolean          @default(true)
  contributionMode               ContributionMode @default(PER_GAME)
  monthlyContributionPerDirector Decimal          @default(70) @db.Decimal(10, 2)
  createdAt                      DateTime         @default(now())
  updatedAt                      DateTime         @updatedAt
  memberships                    TeamMembership[]
  directors                      Director[]
  games                          Game[]
  categories                     Category[]
  transactions                   Transaction[]
}

model TeamMembership {
  id                  String         @id @default(cuid())
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String
  team                Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId              String
  role                Role
  director            Director?      @relation(fields: [directorId, teamId], references: [id, teamId], onDelete: Restrict)
  directorId          String?
  active              Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  transactionsCreated Transaction[]  @relation("TransactionsCreatedByMembership")
  refreshTokens       RefreshToken[]

  @@unique([userId, teamId])
  @@unique([teamId, directorId])
  @@index([teamId, role])
}

model Director {
  id           String           @id @default(cuid())
  team         Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId       String
  name         String
  contact      String?
  active       Boolean          @default(true)
  memberships  TeamMembership[]
  transactions Transaction[]

  @@unique([teamId, name])
  @@unique([id, teamId])
  @@index([teamId, active])
}

model Game {
  id                              String        @id @default(cuid())
  team                            Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId                          String
  date                            DateTime
  location                        String?
  opponent                        String?
  status                          GameStatus    @default(ABERTO)
  expectedContributionPerDirector Decimal       @db.Decimal(10, 2)
  createdAt                       DateTime      @default(now())
  transactions                    Transaction[]

  @@unique([id, teamId])
  @@index([teamId, date])
  @@index([teamId, status])
}

model Category {
  id           String        @id @default(cuid())
  team         Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId       String
  name         String
  type         CategoryType  @default(ENTRADA)
  active       Boolean       @default(true)
  transactions Transaction[]

  @@unique([teamId, name])
  @@unique([id, teamId])
  @@index([teamId, active])
}

model Transaction {
  id                  String          @id @default(cuid())
  team                Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId              String
  type                TransactionType
  amount              Decimal         @db.Decimal(10, 2)
  date                DateTime
  paymentMethod       PaymentMethod
  notes               String?
  game                Game            @relation(fields: [gameId, teamId], references: [id, teamId])
  gameId              String
  category            Category        @relation(fields: [categoryId, teamId], references: [id, teamId])
  categoryId          String
  director            Director?       @relation(fields: [directorId, teamId], references: [id, teamId], onDelete: Restrict)
  directorId          String?
  createdByMembership TeamMembership  @relation("TransactionsCreatedByMembership", fields: [createdByUserId, teamId], references: [userId, teamId])
  createdByUserId     String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([id, teamId])
  @@index([teamId, createdAt])
  @@index([teamId, gameId])
  @@index([teamId, categoryId])
  @@index([teamId, directorId])
}

model RefreshToken {
  id         String         @id @default(cuid())
  tokenHash  String
  userId     String
  teamId     String
  membership TeamMembership @relation(fields: [userId, teamId], references: [userId, teamId], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ip         String?
  createdAt  DateTime       @default(now())

  @@index([userId, revokedAt])
  @@index([teamId])
}
